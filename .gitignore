# Python virtual environment — never commit this
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Distribution / build
dist/
build/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Local env files
.env
*.env
env
app/scripts/msd-auto-download/env
*.local
nul

# Upload metadata cache — runtime-generated, not for version control
app/templates/admin/upload_meta/_upsert_stats.json
app/templates/admin/upload_meta/wo_product_mismatch.json
app/templates/admin/upload_meta/active_open_wos.json
app/templates/admin/upload_meta/incomplete_prev_shipments.json
app/templates/admin/upload_meta/monday_daily_totals.json
app/templates/admin/upload_meta/*.xlsx.meta.json

# Sync state — updated every sync run, not for version control
sync_state.json

# Uploaded Excel files — user-supplied at runtime, not for version control
files/upload/excel/

# Selenium Chrome runtime profile - generated at runtime, not for version control
app/scripts/msd-auto-download/selenium_chrome_profile/

# Large/corrupted DB backups — never commit these
files/lenovo_asp_corrupted_backup.db

# Chrome profile for Resolv
app/scripts/resolve-auto-download/session
# Resolve downloaded files — runtime output, not for version control
files/resolve-auto-download/Extract-AWB/*.xlsx
files/resolve-auto-download/Extract-DC/*.xlsx

# MSD downloaded files — runtime output
files/msd-auto-download/*.xlsx
